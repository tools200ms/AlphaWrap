  [[ -v "_carg_${cname}_${clink}_param" ]] && return 0 || return 1
}

# Return value:
#     0 - argument has been parsed successfully
#     1 - argument can't be interpreted
#
# If parameter is accepted, it must be registered with:
#   carg_set_param function
function parse___autoparam() {
  local cname=$1
  local clink=$2
  local value=$3

  if [ $clink == $value ]; then
    carg_set_param "$cname" $clink 1
    return 0
  fi

  return 1
}


function parse__MODE() {
  local cname=$1
  local clink=$2
  local mode=$3

  case $mode in
    command)
      _carg_chain "command*" $mode
    ;;
    sync)
      _carg_chain "path_local path_remote? --reverse-r?" $mode
    ;;
    enter|console|stop|waitfor|init)
      # no argumans for these options
    ;;
    ls)
      _carg_chain "?--full-f" $mode
    ;;
    extstore)
      _carg_chain "MODE" $mode
    ;;
    run|create)
      # to be handled by 'parse_create' or 'parse_run'
    ;;
    *)
      return 1
  esac

  # set value
  carg_set_param "$cname" $clink $mode

  return 0
}


