function carg_set_param() {
  local cname=$1
  local clink=$2
  local value=$3

  if [ -z ${value} ]; then
    echo "Internel error: "
    echo "    Missing link value: $cname:$clink"
    exit 44
  fi

  declare -gr "_carg_${cname}_${clink}_param=${value}"
}

function carg_isparam_set() {
  local cname=$1
