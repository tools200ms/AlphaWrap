# shellcheck disable=SC2112
function _carg_chain_parse() {
  local chain=$1
  local name=$2
  local arg_type=
  declare -A flag_conv
  declare -A flag_subch_sidx
  declare -A chain_qant
  declare -A chain_param_fn
  local cflag=
  local clflag=
  local cflag_dist=
  local qant=
  local tmp=

  read -a chain_arr <<< "$chain"

  local link_idx=0
  # First chain pass: scann for flags and named parameters:
  $_DBG_MSG "Loading chain: _$name"
  $_DBG_MSG "    $chain"

  for link_idx in ${!chain_arr[@]}; do
    link=${chain_arr[$link_idx]}

    tmp=${link:0,-1}
    if [ "$tmp" == "?" ] || [ "$tmp" == "*" ]; then
      chain_qant[$link_idx]=$tmp
      link=${link:0:-1}
    else
      chain_qant[$link_idx]=
    fi

    tmp=${link:0,-2}
    if [ ${link:0:1} == '-' ]; then
      if [[ ! $tmp =~ ^\-[0-9A-Za-z]$ ]]; then
        echo "Internal error: "
        echo "    Illegal syntax (flag '$link' in '$name: $chain')"
        exit 52
      fi

      cflag=${tmp:1}

      tmp=${link:0:-2}
      if [ -n "$tmp" ]; then
        if [[ ! $tmp =~ ^\-\-[0-9A-Za-z]{1,128}$ ]]; then
          echo "Internal error: "
          echo "    Illegal syntax (flag '$link' in '$name: $chain')"
          exit 51
        fi

        clflag=${tmp:2}
        flag_conv["$cflag"]="$clflag"
        flag_conv["$tmp"]="$cflag"
      else
        flag_conv[$cflag]=$cflag
        clflag=$cflag
      fi

      flag_subch_sidx[$cflag]=$(($link_idx+1))
      link="-$cflag"

      $_DBG_MSG "      ($link_idx) adding flag: $clflag($cflag)${chain_qant[$link_idx]}"
      # it's a flag, 'param function' does not apply here:
      chain_param_fn[$link_idx]=
    else # parameter
      if declare -F parse_${name}_${link} > /dev/null; then
        chain_param_fn[$link_idx]="parse_${name}_${link}"
      else
        chain_param_fn[$link_idx]="parse___autoparam"
      fi

      $_DBG_MSG "      ($link_idx) adding param. fn.: ${chain_param_fn[$link_idx]} ${chain_qant[$link_idx]} expecting: 'parse_${name}_${link}'"
    fi

    # make correction:
    chain_arr[$link_idx]=$link
  done


  link_idx=0
  link_cnt=${#chain_arr[@]}
  # flag_as_param
  local flag_is_flag=true

  $_DBG_MSG "Parsing arguments: "

  while true; do
    if [ $link_idx -ge $link_cnt ]; then
      # last element reached
      $_DBG_MSG "      End of chain: _$name"
      break
    fi

    if [ -z "$CARG" ]; then
      # read and rewind arguments
      CARG=$(first_arg ${ARGS})
      ARGS=$(last_args ${ARGS})

      $_DBG_MSG "    Loading: $CARG"
    fi

    if $flag_is_flag && [[ "${CARG:0:1}" == "-" ]]; then
      # arg_type=CARG_FLAG
      # if long form
      if [[ "${CARG:0:2}" == "--" ]]; then
        clflag=${CARG:2}
        tmp=${flag_conv["$clflag"]}
        cflag=$tmp
      else
        cflag=${CARG:1}
        tmp=${flag_conv["$cflag"]}
        clflag=$tmp
      fi

      if [ -z "$tmp" ]; then
        $_DBG_MSG "      unidentified flag, mark 'flag_is_flag=true' to keep matching in other chains"
        # Flag does not exists in a current chain, but it might be in other one

        flag_is_flag=false
        link_idx=$(($link_idx + 1))
        continue
      fi

      cflag_dist=0
      link_idx=${flag_subch_sidx[$cflag]}

      tmp=$(($link_idx - 1))
      $_DBG_MSG "      identified as a flag: $clflag($cflag) ${chain_qant[$tmp]}"
      # flag exits, mark, and jump to flag specific index
      if [[ -v $_carg_${name}_${clflag}_flag ]]; then
        echo "Repeated flag: --$clflag (-cflag)"
        exit 3
      fi

      declare -g "_carg_${name}_${clflag}_flag=1"

      CARG=
      continue
    else # 'CARG' is a parameter OR an EMPTY string
      link=${chain_arr[$link_idx]}
      qant=${chain_qant[$link_idx]}

      # if param is not defined, arg. is a flag
      if [ -z ${chain_param_fn[$link_idx]} ]; then
        if [ -z $qant ]; then
          tmp=flag_conv[${link}]
          echo "Expecting '--$tmp (-$link)' but '$CARG' encountered"
          exit 2
        fi

        $_DBG_MSG "    Flag in chain encountered: ${flag_conv[$link]}($link)$qant, checking arg. with next chain link"
        # next try
        link_idx=$(($link_idx + 1))
        continue
      fi

      $_DBG_MSG "    Testing arg. against parameter: $link$qant"
      # accept empty parameter to do trought all chain links, so if
      # something is required a proper message is shown
      if [ -z "$CARG" ]; then
        # quantifier is not '?' nor '*'
        $_DBG_MSG "      All arguments exploited, exiting _$name chain"

        break

        #if [ -z "$qant" ]; then

        #  # if not main chain,
        #  if [ -n "$name" ]; then

        #    return 1
        #  fi

        #  echo "Syntax error: "
        #  echo "    Required parameter is missing: '$name:$link'"
        #  exit 31
        #fi

        # rewind to the next link
        #link_idx=$(($link_idx + 1))
        #continue
      fi

      if [ -n "$cflag_dist" ]; then
        cflag_dist=$(($cflag_dist + 1))
      fi

      $_DBG_MSG "      Calling: ${chain_param_fn[$link_idx]} \"${name}\" ${link} $CARG $cflag $cflag_dist"
      if ${chain_param_fn[$link_idx]} "${name}" ${link} $CARG $cflag $cflag_dist; then
        str=_carg_${name}_${link}_param
        tmp="${str}"

        if $flag_is_flag && ! $(carg_isparam_set "${name}" ${link}); then
          echo "No return value has been set."
          exit 8
        fi

        if $flag_is_flag; then
          $_DBG_MSG "      Param variable '$str' has been set with value: '" "${tmp}" "'"
        else
          $_DBG_MSG "      Flag as param. '$CARG' has been accepted by parser"
          flag_is_flag=true
        fi

        # next try
        link_idx=$(($link_idx + 1))
        CARG=
        continue
      fi

      if [ -z $qant ]; then
        echo "Missing required parameter: $link:$name"
        exit 44
      fi

      $_DBG_MSG "      Param have not meet parser conditions, continue maching with a next link"
      link_idx=$(($link_idx + 1))
    fi
  done

  if ! declare -F check_$name > /dev/null; then
        echo "Internal error: "
        echo "    Function 'check_$name' not defined!"
        exit 44
  fi

  check_$name
  return $?
}

