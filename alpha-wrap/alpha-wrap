function parse_CREATE_cmdline() {
  local cname=$1
  local clink=$2
  local cmdl=$3
  local prev_flag=$4
  local prev_flag_dist=$5
  local cmdline=
  local filesize=

  echo "$cname $clink $cmdl $prev_flag $prev_flag_dist"

  if [ $prev_flag != 'C' ] || [ $prev_flag_dist -ne 1 ]; then
    return 1
  fi

  if $(validate_path "${cmdl}") && [ -f "${cmdl}" ]; then
    filesize=$(stat -c%s "$cmdl")

    # assuming file can have a lot of comments
    # this treshold will not allow to load e.g. initramfs
    # (in the case of mistake)
    if (( filesize > 4096 )); then
      _attach_errormsg "File too large, is 'cmdline.txt'?"
        return 1
    fi

    cmdline=$(tail -n 1 "${cmdl}")
  else
    cmdline="${cmdl}"
  fi

  if ! $(validate_cmdline "${cmdl}"); then
    _attach_errormsg "Provided 'command line' does not look legitimate."
    return 2
  fi

  carg_set_param "$cname" $clink "${cmdline}"

  return 0
}

