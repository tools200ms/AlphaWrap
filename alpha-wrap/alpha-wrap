function check_CREATE() {
  local err_enc=false

  if [ -z $_carg_CREATE_file_path_param ]; then
    _attach_errormsg "Provide image path" "create"
    err_enc=true
  fi

  if [ -z $_carg_CREATE_yesno_param ]; then
    _attach_errormsg "Define '--imgboot': yes|no" "create"
    err_enc=true
  fi

  if $err_enc; then
    return 1
  fi

  if ! ${_carg_CREATE_yesno_param}; then
    if [ ! -f "${_carg_CREATE_kelner_param}" ]; then
      if [ -e "${_carg_CREATE_kelner_param}" ]; then
        _attach_errormsg "Path '${_carg_CREATE_kelner_param}' should point to (kernel) file"
      else
        _attach_errormsg "Can not find kernel: '${_carg_CREATE_kelner_param}'"
      fi
      err_enc=true
    fi

    # set realpath
    _carg_CREATE_kelner_param=$(realpath $_carg_CREATE_kelner_param)

    if [ -n "${_carg_CREATE_initramfs_param}" ]; then
      if [ ! -f "${_carg_CREATE_initramfs_param}" ]; then
        if [ -e "${_carg_CREATE_initramfs_param}" ]; then
          _attach_errormsg "Path '${_carg_CREATE_initramfs_param}' should point to (initramfs) file"
        else
          _attach_errormsg "Can not find initramfs: '${_carg_CREATE_initramfs_param}'"
        fi
        err_enc=true
      fi

      _carg_CREATE_initramfs_param=$(realpath $_carg_CREATE_initramfs_param)
    fi
  fi

  if $err_enc; then
    return 1
  fi

  # Create random name if user did not assign
  if [ "${_carg_CREATE_name_flag}" == "1" ] && [ -z ${parse_CREATE_cont_name_param} ]; then
    _carg_CREATE_cont_name_param=$(get_random_name)
    echo "Random name assigned: ${_carg_CREATE_cont_name_param}"
  fi

  return 0
}

