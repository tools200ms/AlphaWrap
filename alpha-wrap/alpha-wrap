function parse__MODE() {
  local cname=$1
  local clink=$2
  local cmd=$3
  local res=0

  case $cmd in
    command|exec)
      CARG=
      cmd="command"
      _carg_chain_parse "arg*" "COMMAND"
      res=$?
    ;;
    sync)
      CARG=
      _carg_chain_parse "--reverse-r? path_local path_remote?" "SYNC"
      res=$?
    ;;
    enter|console)
      # no parameters
      CARG=
      cmd="console"
    ;;
    stop|waitfor|init)
      # no argumans for these options
      CARG=
    ;;
    ls)
      CARG=
      _carg_chain_parse "--full-f?" $cmd
      res=$?
    ;;
    extstore|es)
      cmd="es"
      CARG=
      _carg_chain_parse "MODE" "ES"
      res=$?
    ;;
    create|run)
      CARG=
      # chain to be called later
    ;;
    *)
      # cmd to be defined later from context
      # it might be run or create
      cmd=
      res=1
    ;;
  esac

  # set value
  carg_set_param "$cname" $clink $cmd

#  [ -n "$cmd" ]
  return $res
}


function parse__CREATE() {
