function check_ES_ADD() {
  local cont_name
  local file_name
  local path=
  local is_internal=

  if [ -n "$_carg_ES_ADD_size_param" ]; then
    # size defined, so expecting file name of non-existing file:
    if [ -e "$_carg_ES_ADD_ref_param" ]; then
      _attach_errormsg "File exists ('$_carg_ES_ADD_ref_param'), not touching it!"
      return 1
    fi

    touch "$_carg_ES_ADD_ref_param" &> /dev/null
    if [ $? -ne 0 ]; then
      _attach_errormsg "Cannot create file: $_carg_ES_ADD_ref_param"
      return 1
    fi

    path=$(realpath "$_carg_ES_ADD_ref_param")
  else
    validate_cont_name "$_carg_ES_ADD_ref_param"
    cont_name=$?
    validate_path "$_carg_ES_ADD_ref_param"
    file_name=$?

    if [ $cont_name -ne 0 ] && [ $file_name -ne 0 ]; then
      _attach_errormsg "Illegal name"
      return 1
    fi

    path="${AWSTORE_DIR}/${_carg_ES_ADD_ref_param}.img"
    if [ $cont_name -eq 0 ] && [ -f "$path" ]; then
      # it's a container
      is_internal=true
    fi

    if [ $file_name -eq 0 ] && [ -f "${_carg_ES_ADD_ref_param}" ]; then
      # it's a file
      path="${_carg_ES_ADD_ref_param}"
      is_internal=false
    fi

    if [ -z "$is_internal" ]; then
      _attach_errormsg "Cannot find storage to attach (neither file nor container)"
      return 1
    fi
  fi

  # add special parameter
  carg_set_param "ES_ADD" "path" "${path}"

  return 0
}

