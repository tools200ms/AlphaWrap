function include_all() {
  readonly SCRIPT_PATH=$1
  readonly SCRIPT_BASE=$(basename $1)
  readonly SCRIPT_DIR=$(dirname $1)

  for script in $(ls ${SCRIPT_DIR}/${SCRIPT_BASE}-* 2>/dev/null); do
    if [ -x $script ]; then
      source $script
    fi
  done
}

