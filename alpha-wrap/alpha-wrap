function carg_set_param() {
  local cname=$1
  local clink=$2
  local value=$3

  if [ -z ${value} ]; then
    # no thing to set
    return 0
  fi

  # declare if value not defined, defined value is a default value
  local param_name="_carg_${cname}_${clink}_param"
  if [ -z ${!param_name} ]; then
    declare -gr "${param_name}=${value}"
  else
    eval "${param_name}=${value}"
  fi
}

function carg_isparam_set() {
  local cname=$1
  local clink=$2
  local var="_carg_${cname}_${clink}_param"

  [ -n "${!var}" ]
  return $?
}

# Return value:
#     0 - argument has been parsed successfully
#     1 - argument can't be interpreted
#
# If parameter is accepted, it must be registered with:
#   carg_set_param function
function parse___autoparam() {
  local cname=$1
  local clink=$2
  local value=$3

  if [ $clink == $value ]; then
    carg_set_param "$cname" $clink 1
    return 0
  fi

  return 1
}


function parse__MODE() {
  local cname=$1
  local clink=$2
  local cmd=$3
  local res=0

  case $cmd in
    command|exec)
      CARG=
      cmd="command"
      _carg_chain_parse "arg*" "COMMAND"
      res=$?
    ;;
    sync)
      CARG=
      _carg_chain_parse "--reverse-r? path_local path_remote?" "SYNC"
      res=$?
    ;;
    enter|console)
      # no parameters
      CARG=
      cmd="console"
    ;;
    stop|waitfor|init)
      # no argumans for these options
      CARG=
    ;;
    ls)
      CARG=
      _carg_chain_parse "--full-f?" $cmd
      res=$?
    ;;
    extstore|es)
      cmd="es"
      CARG=
      _carg_chain_parse "MODE" "ES"
      res=$?
    ;;
    create|run)
      CARG=
      # chain to be called later
    ;;
    *)
      # cmd to be defined later from context
      # it might be run or create
      cmd=
      res=1
    ;;
  esac

  # set value
  carg_set_param "$cname" $clink $cmd

#  [ -n "$cmd" ]
  return $res
}


function parse__CREATE() {
  local res=0

  if [ ! -z $_carg__MODE_param ] && [ "$_carg__MODE_param" != "create" ]; then
    return 1
  fi

  _carg_chain_parse "--device-d? dev_name? file_path extr_size? --imgboot-i yesno kelner? initramfs? --name-n? cont_name?" "CREATE"
  res=$?

  if [ $res -eq 0 ] && [ -z $_carg__MODE_param ]; then
    carg_set_param "" "MODE" "create"
  fi

  return $res
}

_carg_create_dev_name_param=raspi3b
function parse_CREATE_dev_name() {
  local cname=$1
  local clink=$2
  local name=$3
  local prev_flag=$4
  local prev_flag_dist=$5

  if [ "$prev_flag" != "d" ] || [ "$prev_flag_dist" != "1" ]; then
    return 1
  fi

  if [[ ! "$name" =~ ^([a-zA-Z0-9\._-]){1,128}$ ]]; then
    echo "Illegal machine (device) name"
    exit 3
  fi

  local machine=$(qemu-system-aarch64 -machine help | grep "^${name}[[:space:]].*")

  if [ -z "$machine" ]; then
    echo "Machine (device) has not been found: $name"
    exit 3
  fi

  # echo "Loading: $machine"
  carg_set_param "$cname" $clink $(first_arg $machine)

  return 0
}

function parse_CREATE_file_path() {
  local cname=$1
  local clink=$2
  local path=$3

  if [ -n "$path" ]; then
    path=$(realpath $path)
    if [ -f $path ]; then
      # set value
      carg_set_param "$cname" $clink $path
      return 0
    fi

    if [ -z $__carg__MODE_param ]; then
      # this will force to try next chain
      return 1
    else
      echo "Provide path to an existing file"
      exit 3
    fi
  fi

  return 1
}

function parse_CREATE_extr_size() {
  local cname=$1
  local clink=$2
  local size="$3"
  local res=

  if [ "${size:0:1}" != '+' ]; then
    return 1
  fi

  size="${size:1}"
  size="$(parse_size "$size")"
  res=$?

  if [ $res -ne 0 ]; then
    echo "Incorrect size format"
    exit 22
  fi

  carg_set_param "$cname" $clink "$size"
  return 0
}

function parse_CREATE_yesno() {
  local cname=$1
  local clink=$2
  local value=$3
  local prev_flag=$4
  local prev_flag_dist=$5

  if [ $prev_flag != 'i' ] || [ $prev_flag_dist -ne 1 ]; then
    return 1
  fi

  if [[ $(echo "$value" | tr '[:upper:]' '[:lower:]') =~ ^y|yes|1|on$ ]] ; then
    carg_set_param "$cname" $clink true
  elif [[ $(echo "$value" | tr '[:upper:]' '[:lower:]') =~ ^n|no|0|off$ ]] ; then
    carg_set_param "$cname" $clink false
  else
    echo "Correct option is one of: yes, y, on, 1 or no, n, 0, off"
    exit 3
  fi

  return 0
}

