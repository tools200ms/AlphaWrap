_carg_CREATE_dev_name_param=raspi3b
function parse_CREATE_dev_name() {
  local cname=$1
  local clink=$2
  local name=$3
  local prev_flag=$4
  local prev_flag_dist=$5

  if [ "$prev_flag" != "d" ] || [ "$prev_flag_dist" != "1" ]; then
    return 1
  fi

  if [[ ! "$name" =~ ^([a-zA-Z0-9\._-]){1,128}$ ]]; then
    echo "Illegal machine (device) name"
    exit 3
  fi

  local machine=$(qemu-system-aarch64 -machine help | grep "^${name}[[:space:]].*")

  if [ -z "$machine" ]; then
    echo "Machine (device) has not been found: $name"
    exit 3
  fi

  # echo "Loading: $machine"
  carg_set_param "$cname" $clink $(first_arg $machine)

  return 0
}

function parse_CREATE_file_path() {
  local cname=$1
  local clink=$2
  local path=$3

  if [ -n "$path" ]; then
    path=$(realpath $path)
    if [ -f $path ]; then
      # set value
      carg_set_param "$cname" $clink $path
      return 0
    fi

    if [ -z $__carg__MODE_param ]; then
      # this will force to try next chain
      return 1
    else
      echo "Provide path to an existing file"
      exit 3
    fi
  fi

  return 1
}

function parse_CREATE_extr_size() {
  local cname=$1
  local clink=$2
  local size="$3"
  local res=

  if [ "${size:0:1}" != '+' ]; then
    return 1
  fi

  size="${size:1}"
  size="$(parse_size "$size")"
  res=$?

  if [ $res -ne 0 ]; then
    echo "Incorrect size format"
    exit 22
  fi

  carg_set_param "$cname" $clink "$size"
  return 0
}

function parse_CREATE_yesno() {
  local cname=$1
  local clink=$2
  local value=$3
  local prev_flag=$4
  local prev_flag_dist=$5

  if [ $prev_flag != 'i' ] || [ $prev_flag_dist -ne 1 ]; then
    return 1
  fi

  if [[ $(echo "$value" | tr '[:upper:]' '[:lower:]') =~ ^y|yes|1|on$ ]] ; then
    carg_set_param "$cname" $clink true
  elif [[ $(echo "$value" | tr '[:upper:]' '[:lower:]') =~ ^n|no|0|off$ ]] ; then
    carg_set_param "$cname" $clink false
  else
    echo "Correct option is one of: yes, y, on, 1 or no, n, 0, off"
    exit 3
  fi

  return 0
}

