function parse_reverse_sync() {
  if [ "$1" == "-r" ] || [ "$1" == "--reverse" ]; then
    _RSYNC_REVERSE=1
    # read
    return 1
  fi

  return 0
}

function set_sync() {
  # arg (param, flag) or chain (root chain, param chain, flag chain)

  # skip arg. setters
  if [ $# -eq 2 ]; then
    # accept
    return 1
  fi

  # set flag
  if [ $# -eq 1 ]; then
    # per parameter setter call
    parse_reverse_sync "${1}"
    retval=$?
    return ${retval}
  fi

  # final setter call:
  local l_loc
  local r_loc

  l_loc=$(realpath ${_RSYNC_LOCAL})
  r_loc="${_RSYNC_REMOTE}"

  if [ ! -e ${l_loc} ]; then
    echo "File or directory does not exists!"

    exit 3
  fi
}

