      # ${_carg_CREATE_yesno_param} ${_carg_CREATE_kelner_param} ${_carg_CREATE_initramfs_param} ${_carg_CREATE_name_flag} ${parse_CREATE_cont_name_param}"
      #--device-d? dev_name? file_path extr_size? --imgboot-i yesno kelner? initramfs? --name-n? cont_name?" "create
      local cont_name=

      if [ ! -z ${_carg_CREATE_name_flag} ]; then
        cont_name=${_carg_CREATE_cont_name_param}
      else
        cont_name=$(basename $(mktemp --tmpdir=${AWSTORE_DIR} --suffix=.img) ".img")
      fi

      op_create $cont_name
      op_run $cont_name 1
    ;;
    run)
      op_run ${_carg_RUN_name_param}
    ;;
    command)
      # echo "Command: " $_carg_COMMAND_arg_param
      load_containersettings
      op_gcommand
    ;;
    sync)
      # echo "Sync: " $_carg_SYNC_path_local_param $_carg_SYNC_path_remote_param "$_carg_SYNC_reverse_flag"
      load_containersettings
      op_sync
    ;;
    console)
      load_containersettings
      op_enter
    ;;
    ls)
      check_environment

      load_containersettings || res=$?
      op_list
    ;;
    stop)
      load_containersettings
      stop_machine && rm_lock_file || res=$?

      if [ $res -ne 0 ]; then
        echo "Errors has been encountered"
        return $res
      fi

      if [ -n "$(echo ${_CONTAINER_NAME} | grep -e '^tmp\.')" ]; then
        echo "Tempolary container has been removed"
        op_remove ${_CONTAINER_NAME}
      fi
    ;;
    waitfor)
      load_containersettings
      op_waitfor || res=$?
    ;;
    es)
      case $_carg_ES_MODE_param in
        ls)
          echo "External storage list: "
          if [ "${_carg_es_ls_full_flag}" == "1" ]; then
            ls -l "${EXTSTORE_DIR}"
          else
            ls "${EXTSTORE_DIR}"
          fi
        ;;
        add)
          # echo "add ${_carg_ES_ADD_ref_param} ${_carg_ES_ADD_size_param}: ${_carg_ES_ADD_path_param}"
          if [ -n "${_carg_ES_ADD_size_param}" ]; then
            prepare_usbstick "${_carg_ES_ADD_path_param}" ${_carg_ES_ADD_size_param}
          fi

          insert_usbstick "${_carg_ES_ADD_path_param}"
        ;;
        eject)
          # issues: does not work
          remove_usbstick
        ;;
      esac
    ;;
    init)
      exit_if_not_root

      echo "Initializing $SCRIPT_BASE database and storage"
      init

      exit $?
    ;;
  esac

  return 0
}

main
exit $?
