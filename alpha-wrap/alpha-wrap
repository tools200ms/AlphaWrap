      # running tempolary container
      CONT_FILE=$(mktemp --tmpdir=${AWSTORE_DIR} --suffix=.img)
      _CONTAINER_NAME=$(basename ${CONT_FILE} ".img")
    fi

    prepare_mmc_imgfile ${_IMG_FILE} ${CONT_FILE}

    # set container's permissions for unprivileged user:
    chgrp libvirt ${CONT_FILE}
    chmod g+rw    ${CONT_FILE}

    mkdir -p ${DB_DIR}/${_CONTAINER_NAME}

    local kernel=
    local initrd=
    local cmdline=

    # root required
    if $_carg_CREATE_yesno_param; then
      # mount boot partition
      mount_boot $CONT_FILE

      kernel=${BOOT_MNT_DIR}/${_carg_CREATE_kelner_param}

      if [ ! -f "${kernel}" ]; then
        echo "Can not find kernel: ${kernel}"
        exit 44
      fi

      if [ -n "${_carg_CREATE_initramfs_param}" ]; then
        initrd=${BOOT_MNT_DIR}/${_carg_CREATE_initramfs_param}
        if [ ! -f "${initrd}" ]; then
          echo "Can not find initrd: ${initrd}"
          exit 44
        fi
      fi

      if [ -f ${BOOT_MNT_DIR}/cmdline.txt ]; then
        cmdline=${BOOT_MNT_DIR}/cmdline.txt
      fi
    else
      kernel=${_carg_CREATE_kelner_param}
      initrd=${_carg_CREATE_initramfs_param}
    fi

    # installation
    $RUN cp ${kernel} ${DB_DIR}/${_CONTAINER_NAME}/
    kernel=${DB_DIR}/${_CONTAINER_NAME}/$(basename ${kernel})

    if [ -n "${cmdline}" ]; then
      $RUN cp ${cmdline} ${DB_DIR}/${_CONTAINER_NAME}/cmdline.txt
      cmdline=${DB_DIR}/${_CONTAINER_NAME}/cmdline.txt
    fi

    if [ -n "${initrd}" ]; then
      $RUN cp ${initrd} $DB_DIR/$_CONTAINER_NAME/
      initrd=$DB_DIR/$_CONTAINER_NAME/$(basename ${initrd})
    fi

    cat <<EOF > $DB_DIR/${_CONTAINER_NAME}/config.txt
# file auto-generated
container $_CONTAINER_NAME
device    $_carg_CREATE_dev_name_param
kernel    ${kernel}
initramfs ${initrd}
imgboot   $_carg_CREATE_yesno_param

rootimg   $_carg_CREATE_file_path_param
cdate     $(date)
EOF

    $RUN chgrp libvirt -R ${DB_DIR}/${_CONTAINER_NAME}
    $RUN chmod g+w -R ${DB_DIR}/${_CONTAINER_NAME}

    # umount boot partition
    $_carg_CREATE_yesno_param umount_boot || true
  ;;

  container)
