#!/bin/sh

[ -n "$PRETEND" ] && $(echo "$PRETEND" | tr '[:upper:]' '[:lower:]' | grep -Eq '^(y|yes|1|on)$') && \
        RUN="echo 'Now we shall run:'" || RUN=""

[ -n "$DEBUG" ] && $(echo "$DEBUG" | tr '[:upper:]' '[:lower:]' | grep -Eq '^(y|yes|1|on)$') && \
        set -xe || set -e

# functions:
get_inspiration_word() {
  local word="inspiration"
  local skip_words=32
  local quotation=

  while [ $skip_words -gt -100 ]; do
    quotation=$(fortune | sed -e s/\\\\/\\\\\\\\/g -e s/\"/\\\\\"/g -e s/\'/\\\\\'/g | tr '\n' ' ' | tr "," ' ' | xargs)

    if [ -z "$quotation" ]; then
      # strangely no output from fortune, just quit function
      break
    fi

    for w in $quotation; do
      if [ $(echo -n $w | wc -c) -gt 3 ] && [ $skip_words -lt 1 ]; then
        word=$w
        skip_words=-100
        break
      fi
      skip_words=$((skip_words-1))
    done
  done

  echo -n $word
}

# texts:

present_ntp_notification() {
  local res=0
  cat <<EOF
No NTP service found, system might not have a correct time
that is necessary for SSL connections.

Do you want to proceed?
EOF

  read -p "    yes(y) for continuation: " choose
  echo "$choose" | tr '[:upper:]' '[:lower:]' | grep -Eq '^(y|yes|affirmative)$' || res=$?

  return $res
}

present_hostname_inspiration_option() {
  local res=0
  cat <<EOF
It's time to setup hostname, if you have no clue what to choose, type 'inspiration'.
'setup-finish' will pick some random words from random quotations that can hopefully
inspire you to come up with a name.

(if you don't need inspiration just hit ENTER)
(to serve inspiration words package 'fortune' will be automatically added)

EOF

  read -p "    type 'inspiration': " choose
  $(echo "$choose" | tr '[:upper:]' '[:lower:]' | grep -Eq '^inspiration$') || res=$?

  return $res
}


setup_hostname_with_inspiration() {
  local res=0

  echo -e "Inspiration words are: \n     - '$(get_inspiration_word)'\n     - '$(get_inspiration_word)'\n     - '$(get_inspiration_word)'\n"
  read -p "    Enter hostname (or hit ENTER for more inspiration words): " choose

  if [ -n "$choose" ]; then
    $RUN setup-hostname "$choose" || res=$?

    return $res
  fi

  return 1
}

present_passwd_upd() {
cat <<EOF
In the next step, the 'root' account will be disabled, and a password
will be set for the 'master' user.
EOF
}

main() {
  set -e
  trap 'echo "An error occurred in my_function"; exit 1' ERR

  if ! $(/etc/init.d/ntpd -q status &> /dev/null); then
    # exit if 'not yes'
    present_ntp_notification
  fi

  $RUN setup-keymap && echo -e ""

  $RUN setup-timezone && echo -e ""

  $RUN setup-apkcache /var/cache/apk

  # if network not se, set it: setup-interfaces && setup-proxy
  $RUN apk add ca-certificates wget && $RUN update-ca-certificates

  if present_hostname_inspiration_option; then
    $RUN apk add fortune

    while ! setup_hostname_with_inspiration; do :; done
  else
    $RUN setup-hostname
  fi

  # change repository:
  $RUN setup-apkrepos -c && echo -e "Repository configuration DONE.\n"

  present_passwd_upd
  while true; do $RUN passwd master && break || true; done
  $RUN passwd -l root

  $RUN rc-update del message default
  $RUN chmod -x /etc/profile.d/message

  echo "All done, have a Happy Day!"
}

res=0

main || res=$?

exit $res
