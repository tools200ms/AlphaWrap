#!/sbin/openrc-run

depend() {
        need localmount sysfs
        after *
}

start() {
        einfo "Please login as 'master' (no password)"
        einfo "    and that 'setup-finish' to finalize setup."

        einfo ""

        local assigned_inets=$(ip -o addr show | grep -v ' lo '| awk '{print $4}')

        if [ -z ${assigned_inets} ]; then
            einfo "No IPs assigned"
        else
            einfo "Assigned IPs: "
            for inet_addr in ; do
                einfo "    $inet_addr"
            done
        fi

        if [ $(ls /tmp/test/*.pub 2>/dev/null | wc -l) -ne 0 ]; then
            einfo ""
            einfo "If you did setup ssh-key you can login"
            einfo "    ssh -i key_path admin@102.303.342.094"
        fi

        eend 0
}


