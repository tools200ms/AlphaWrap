#!/sbin/openrc-run
# Auto-setup service fo AlpBase, to be run at the
# beginning after/before Alpine's 'firstboot''.
# If installation is successful, script is not called again.

readonly VERSION=0.4

# Setup configuration BEGIN

# <==- Edition specific variable declarations place holder, do NOT remove NOR edit this commend -==>

# END OF Setup configuration

RUN=

# Checkout for --dry-run flag
for arg in "$@"; do
  case "$arg" in
    --dry-run|-Z)
        RUN="einfo [pretend] "
    ;;
    -v)
        set -xe
    ;;
    -V)
        echo "${RC_SVCNAME}, version: ${VERSION}"
        return 0
    ;;
  esac
done


blkd_check_sizes_and_grow_fs() {
    local sys_dev=$1
    local root_dev=$2

    # sizes in bytes ('--getsize64' option returns bytes):
    local bdev_size=
    local part_sum_size=0

    for blkd in $(ls ${sys_dev}*); do
        if [ "${blkd}" == "${sys_dev}" ]; then
            bdev_size=$(blockdev --getsize64 ${sys_dev})
            continue;
        fi
        part_sum_size=$(( $(blockdev --getsize64 ${blkd}) + ${part_sum_size} ))
    done

    echo "DIFF: $(($bdev_size - $part_sum_size))"
    echo "    $bdev_size $part_sum_size"

    blkd_grow_fs $sys_dev $root_dev
}

blkd_grow_fs() {
    local sys_dev=$1
    local root_dev=$2
    local resize_cmd=

    case $(lsblk -no fstype ${root_dev}) in
        ext4)
            resize_cmd="resize2fs"
        ;;
        *)
            echo "Unsupported filesystem"
            return 1
        ;;
    esac

    $RUN fdisk ${sys_dev} <<EOF
d
2
n
p
2


N
w
EOF

    $RUN partprobe ${sys_dev}

    $RUN ${resize_cmd} ${root_dev}

    mount -o remount,rw ${root_dev}
}

find_blockdev_check_sizes_and_grow_fs() {
    local root_dev=$(realpath /dev/root)
    local sys_blkn=$(lsblk -no pkname ${root_dev})

    blkd_check_sizes_and_grow_fs "/dev/${sys_blkn}" ${root_dev}
}

check_devd() {
    echo $DEVD
}

install_sshkeys() {
    if [ ! -d "/boot/_ssh" ]; then
        return 0
    fi

    for key_file in $(ls /boot/_ssh/*.pub 2>/dev/null); do
        echo "Found key: $key_file"
        #echo "$KOPT_ssh_key" > /root/.ssh/authorized_keys
    done
}

start() {
    ebegin "Starting ${RC_SVCNAME} (version: ${VERSION})"

    ls -aFl /boot
    find_blockdev_check_sizes_and_grow_fs
    check_devd

    echo $RUN

    install_sshkeys

	$RUN rm -f /etc/runlevels/*/$RC_SVCNAME

	# local rc=0

	eend $rc
}

