#!/sbin/openrc-run
# Auto-setup service fo AlpBase, to be run at the
# beginning after/before Alpine's 'firstboot''.
# If installation is successful, script is not called again.

readonly VERSION=0.5

# Setup configuration BEGIN

# <==- Edition specific variable declarations place holder, do NOT remove NOR edit this commend -==>

# END OF Setup configuration

RUN=

# Checkout for --dry-run flag
for arg in "$@"; do
  case "$arg" in
    --dry-run|-Z)
        RUN="einfo [pretend] "
    ;;
    -v)
        set -xe
    ;;
    -V)
        echo "${RC_SVCNAME}, version: ${VERSION}"
        return 0
    ;;
  esac
done


blkd_check_sizes_and_grow_fs() {
    local sys_dev=$1
    local root_dev=$2

    # sizes in bytes ('--getsize64' option returns bytes):
    local bdev_size=
    local part_sum_size=0
    local nopart_space=0

    for blkd in $(ls ${sys_dev}*); do
        if [ "${blkd}" == "${sys_dev}" ]; then
            bdev_size=$(blockdev --getsize64 ${sys_dev})
            continue;
        fi
        part_sum_size=$(( $(blockdev --getsize64 ${blkd}) + ${part_sum_size} ))
    done

    nopart_space=$(($bdev_size - $part_sum_size))

    if [ ${nopart_space} -gt 1048576 ]; then
        einfo "Found $((${nopart_space}/1048576))MiB of un-partitioned space"
        blkd_grow_fs $sys_dev $root_dev
    fi
}

blkd_grow_fs() {
    local sys_dev=$1
    local root_dev=$2
    local resize_cmd=

    case $(lsblk -no fstype ${root_dev}) in
        ext4)
            resize_cmd="resize2fs"
        ;;
        f2fs)
            resize_cmd="resize.f2fs"
        ;;
        *)
            eerror "Unsupported filesystem"
            return 1
        ;;
    esac

    $RUN fdisk ${sys_dev} <<EOF > /dev/null
d
2
n
p
2


w
EOF

    # 'Resource busy' message
    # $RUN partprobe ${sys_dev}

    $RUN ${resize_cmd} ${root_dev}

    mount -o remount,rw ${root_dev}
}

find_blockdev_check_sizes_and_grow_fs() {
    local root_dev=$(realpath /dev/root)
    local sys_blkn=$(lsblk -no pkname ${root_dev})

    blkd_check_sizes_and_grow_fs "/dev/${sys_blkn}" ${root_dev}
}


dosetup() {
    # ssh keys
    for key_file in $(ls /boot/conf/*.pub 2>/dev/null); do
        echo "Found key: $key_file"
        #cat $key_file >> /home/master/.ssh/authorized_keys
    done
}

start() {
    local rc=0
    local pass_no=1

    if [ -f /root/.pass ]; then
        pass_no=2
    fi

    ebegin "Starting ${RC_SVCNAME} (version: ${VERSION}) Pass: $pass_no"

    if [ $pass_no -eq 1 ]; then
        fstrim -va
        find_blockdev_check_sizes_and_grow_fs

        setup-devd $DEVD

        mount /boot
        [ -f /boot/TESTING ] && TESTING_ON=1 || true

        if [ -d "/boot/conf" ]; then
            dosetup && shred /boot/conf/* && rmdir /boot/conf
        fi
        umount /boot

        touch /root/.pass
        sync
    else
        mount /boot
        [ -f /boot/TESTING ] && TESTING_ON=1 || true
        umount /boot

        setup-interfaces -a
        [ -n "$NTP" ] && [ $NTP != "none" ] && setup-ntp $NTP || ewarn "No NTP configured"

        if [ -f /home/master/.ssh/authorized_keys ]; then
            [ -f /etc/init.d/ssh ] && rc-update add ssh default || awarn "'authorized_keys' exists but no SSH server available"
        fi

        $RUN rm -f /etc/runlevels/*/$RC_SVCNAME
    fi

    eend $rc

	if [ $pass -eq 1 ] && [ -z $TESTING_ON ]; then
	    einfo "Setup successful, rebooting system"
	    sleep .5
	    reboot
	else
	    einfo "Distribution TESTING mode ON"
	fi
}

